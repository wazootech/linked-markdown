# Enforce LF line endings for all text files, on every platform.
# The Deno toolchain (deno fmt / lint / check) emits and expects LF; working
# trees must never silently flip committed files to CRLF on Windows checkouts.
* text=auto eol=lf

# Windows batch scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Conformance fixture inputs intentionally contain CRLF / BOM byte sequences.
conformance/cases/crlf-line-endings/input.md -text
conformance/cases/utf8-bom/input.md -text
